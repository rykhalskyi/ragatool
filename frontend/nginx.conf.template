server {
  listen 80;
  server_name _;

  # Imports can be large books/archives; do not reject them at the proxy.
  client_max_body_size 512m;

  # Baseline security headers. HSTS is intentionally left to the TLS
  # terminator (Cloudflare, ingress) so local HTTP deployments keep working.
  include /etc/nginx/security-headers.conf;

  # --- FIX: serve favicon correctly ---
  location = /favicon.ico {
    root /usr/share/nginx/html;
    try_files /favicon.ico =404;
    access_log off;
    log_not_found off;
  }

  # Never cache the runtime config: it is generated at container start.
  # add_header in a location disables inheritance, so include the headers
  # again here instead of losing the CSP for config.js.
  location = /config.js {
    root /usr/share/nginx/html;
    include /etc/nginx/security-headers.conf;
    add_header Cache-Control "no-store" always;
  }

  # Proxy the API through the same origin by default (API_URL=/api). The
  # backend URL is deploy-time configurable via BACKEND_URL. Disable buffering
  # so /logs/stream (SSE) is flushed immediately.
  location /api/ {
    proxy_pass ${BACKEND_URL}/;
    proxy_http_version 1.1;
    # Preserve the port so the backend's Origin check can compare it.
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location / {
    root /usr/share/nginx/html;
    index index.html index.htm;
    try_files $uri $uri/ /index.html;
  }

  error_page 500 502 503 504 /500.html;
  location = /500.html {
    root /usr/share/nginx/html;
  }
}
