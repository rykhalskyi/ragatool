server {
  listen 80;
  server_name _;

  # Imports can be large books/archives; do not reject them at the proxy.
  client_max_body_size 512m;

  # Baseline security headers. HSTS is intentionally left to the TLS
  # terminator (Cloudflare, ingress) so local HTTP deployments keep working.
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  add_header Cross-Origin-Opener-Policy "same-origin" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

  # --- FIX: serve favicon correctly ---
  location = /favicon.ico {
    root /usr/share/nginx/html;
    try_files /favicon.ico =404;
    access_log off;
    log_not_found off;
  }

  # Never cache the runtime config: it is generated at container start.
  location = /config.js {
    root /usr/share/nginx/html;
    add_header Cache-Control "no-store";
  }

  # Proxy the API through the same origin by default (API_URL=/api). The
  # backend URL is deploy-time configurable via BACKEND_URL. Disable buffering
  # so /logs/stream (SSE) is flushed immediately.
  location /api/ {
    proxy_pass ${BACKEND_URL}/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location / {
    root /usr/share/nginx/html;
    index index.html index.htm;
    try_files $uri $uri/ /index.html;
  }

  error_page 500 502 503 504 /500.html;
  location = /500.html {
    root /usr/share/nginx/html;
  }
}
