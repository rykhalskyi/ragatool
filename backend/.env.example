# Backend environment settings
# Add any required environment variables here.

# Embedding model used for new collections (fastembed model id).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Where fastembed caches downloaded models (mount this in Docker).
FASTEMBED_CACHE_DIR=.fastembed

# Cross-encoder reranker model (downloaded on first use).
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# RerankEnabled and RetrievalFetchK are normally configured in the Settings
# view. These environment variables are only fallbacks when the DB row is
# missing.
# RERANK_ENABLED=true
# RETRIEVAL_FETCH_K=40

# Optional: override the version reported by /version and the UI.
# APP_VERSION=0.1.0

# Sessions are stored in SQLite; no signing key is required.
# When unset, cookies are Secure if any ALLOWED_ORIGINS entry uses https://.
# Set explicitly to true/false to override (local HTTP deployments need false).
# COOKIE_SECURE=false

# Session lifetime in hours (default 168 = 7 days).
SESSION_MAX_AGE_HOURS=168

# Public origin(s) allowed to make credentialed requests. Use exact
# scheme://host[:port] values, comma-separated. Anything not listed must match
# the request's own origin. Set this when exposing Ragatool through a tunnel,
# ingress, or on a non-default port.
# ALLOWED_ORIGINS=https://ragatool.example.com,http://192.168.1.10:4300

# Interactive API docs are off by default; enable them for local development.
# ENABLE_API_DOCS=true

# Persist these paths when running in a container. The bundled compose files
# mount a named volume at /app/data.
# DATABASE_PATH=/app/data/ragatouille.db
# CHROMA_PATH=/app/data/chroma_data

# Encrypts LLM API keys stored in the llm_profiles table. Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# When unset, Ragatool creates a key file next to the database (mode 0600) and
# reuses it. Set this explicitly for multiple instances or when the data
# directory is not writable. Losing the key requires re-entering API keys.
# RAGATOOL_ENCRYPTION_KEY=
# Optional override for the fallback key file location.
# RAGATOOL_ENCRYPTION_KEY_FILE=/app/data/.llm_key

# LLM base URLs are blocked when they resolve to loopback, private, link-local,
# or reserved addresses (protects against SSRF, e.g. cloud metadata). Set this
# to allow local/private providers such as Ollama or LM Studio on your network.
# RAGATOOL_LLM_ALLOW_PRIVATE_URLS=false

# First-run setup code lifetime. Restart the backend to print a new code after
# it expires.
# SETUP_CODE_TTL_MINUTES=15

# Optional headless admin seed. When set and no user exists, /setup is skipped.
# Generate the hash with:
#   docker compose exec backend python -m app.internal.auth hash-password
# RAGATOOL_ADMIN_USERNAME=admin
# RAGATOOL_ADMIN_PASSWORD_HASH=$2b$12$...

# URL import crawler. JS render settings are normally configured in the
# Settings view; environment variables cover deployment-level knobs.
# PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
# CRAWL_MAX_BROWSERS=1
# Allow URLs that resolve to private/loopback addresses (trusted deployments).
# ALLOW_PRIVATE_URLS=false
# Optional CSS selector to wait for after loading a rendered page.
# CRAWL_WAIT_SELECTOR=#content
