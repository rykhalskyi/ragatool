# Backend environment settings
# Add any required environment variables here.

# Embedding model used for new collections (fastembed model id).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Where fastembed caches downloaded models (mount this in Docker).
FASTEMBED_CACHE_DIR=.fastembed

# Cross-encoder reranker model (downloaded on first use).
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# RerankEnabled and RetrievalFetchK are normally configured in the Settings
# view. These environment variables are only fallbacks when the DB row is
# missing.
# RERANK_ENABLED=true
# RETRIEVAL_FETCH_K=40

# Optional: override the version reported by /version and the UI.
# APP_VERSION=0.1.0
